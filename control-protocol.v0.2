{
  "meta": {
    "spec_version": "0.2",
    "status": "draft",
    "created": "2026-03",
    "updated": "2026-03",
    "license": "All rights reserved — 2026 Watadani",
    "related_documents": {
      "overview": "docs/overview.md",
      "state_machine": "docs/state-machine.md",
      "responsibility_matrix": "governance/responsibility-matrix.md",
      "cip_source": "https://github.com/watadani-byte/character-identity-protocol"
    },
    "notes": "This specification is a draft. All values are subject to change. Threshold values are operator-configurable and not prescribed by this specification."
  },

  "external_dependencies": {
    "drift_detection": {
      "description": "Drift detection signals are generated by an external monitoring layer.",
      "defined_in": "Operator-defined monitoring configuration",
      "note": "This specification does not define the monitoring implementation."
    },
    "identity_gate_definitions": {
      "description": "Identity gate criteria (Face, Skeleton, Proportion) are defined per the CIP framework.",
      "defined_in": "https://github.com/watadani-byte/character-identity-protocol",
      "note": "Gate definitions are external to this specification."
    },
    "role_assignments": {
      "description": "Operator, Approver, Monitor, and Auditor role assignments are defined externally.",
      "defined_in": "governance/responsibility-matrix.md"
    },
    "audit_log_infrastructure": {
      "description": "Audit log storage and retrieval infrastructure is operator-defined.",
      "defined_in": "Operator-defined logging system",
      "note": "This specification defines required fields only."
    },
    "threshold_values": {
      "description": "Drift threshold values are operator-configured before deployment.",
      "defined_in": "thresholds section of this specification",
      "note": "No default values are prescribed. Operators must define values before deployment."
    }
  },

  "pal": {
    "role": "Persistent Anchor Layer — maintains continuously available anchor materials across sessions",
    "anchor_reference": {
      "description": "A validated identity reference asset registered in a persistent layer",
      "format": "UID definition + anchor image",
      "availability": "persistently_available_across_sessions"
    },
    "identity_constraints": {
      "description": "Structural and register constraints derived from the anchor",
      "includes": ["visual_identity", "behavioral_posture", "interactional_register", "role_identity"]
    },
    "responsibility_boundary": {
      "description": "PAL provides the persistence infrastructure. It does not govern state transitions or intervention logic.",
      "not_responsible_for": ["state_transition_decisions", "drift_detection", "recovery_approval"]
    }
  },

  "cip": {
    "role": "Character Identity Protocol — foundational governance primitives for identity convergence",
    "primitives": {
      "anchor": "Validated identity reference — single source of truth",
      "identity_gates": "PASS / FAIL validation logic (Face, Skeleton, Proportion)",
      "hard_abort": "Mandatory stop on identity gate failure",
      "re_convergence": "Controlled recovery from last verified anchor state"
    },
    "relation_to_pal": {
      "pal": "Persistence infrastructure — where anchor materials live",
      "cip": "Validation and recovery logic — how identity is governed"
    },
    "source": "https://github.com/watadani-byte/character-identity-protocol"
  },

  "control_targets": {
    "description": "The dimensions of AI system behavior governed by this framework",
    "targets": {
      "identity_consistency": {
        "description": "The system produces outputs consistent with its defined identity anchor",
        "evaluation": "identity_gate_evaluation"
      },
      "role_integrity": {
        "description": "The system maintains its defined operational role across sessions and turns",
        "evaluation": "operator_assessment"
      },
      "behavioral_posture": {
        "description": "The overall behavioral orientation of the system remains within defined bounds",
        "evaluation": "operator_assessment"
      },
      "interactional_register": {
        "description": "The tone, social impression, and interactional style remain consistent with the anchor definition",
        "evaluation": "operator_assessment"
      },
      "responsibility_boundary": {
        "description": "The system does not exceed its defined operational scope",
        "evaluation": "operator_assessment"
      }
    }
  },

  "states": {
    "L0": {
      "name": "Normal Operation",
      "description": "Identity within defined bounds. Full capability available.",
      "allowed_operations": ["full_response_capability"],
      "restricted_operations": [],
      "required_monitoring": "continuous_drift_monitoring",
      "exit_conditions": {
        "to_L1": "drift_indicators_exceed_L1_threshold"
      }
    },
    "L1": {
      "name": "Anomaly Detected",
      "description": "Drift indicators observed. Monitoring intensified. Intervention readiness raised.",
      "allowed_operations": ["full_response_capability"],
      "restricted_operations": [],
      "required_monitoring": "intensified_drift_monitoring",
      "exit_conditions": {
        "to_L0": "drift_indicators_resolve_below_L0_threshold_sustained",
        "to_L2": "drift_indicators_exceed_L2_threshold"
      }
    },
    "L2": {
      "name": "Safe Mode",
      "description": "Capability reduced. Drift containment active.",
      "allowed_operations": ["reduced_capability_responses"],
      "restricted_operations": ["full_capability_responses"],
      "required_monitoring": "continuous_with_operator_consultation",
      "exit_conditions": {
        "to_L1": "containment_successful_indicators_reduced",
        "to_L3": "containment_insufficient_indicators_worsen"
      }
    },
    "L3": {
      "name": "Emergency Stop",
      "description": "Hard Abort triggered. All output halted.",
      "allowed_operations": [],
      "restricted_operations": ["all_response_generation"],
      "required_monitoring": "human_notification_mandatory",
      "exit_conditions": {
        "to_L4": "human_review_initiated_and_operator_acknowledged"
      }
    },
    "L4": {
      "name": "Recovery Standby",
      "description": "Awaiting human review and approval before re-convergence.",
      "allowed_operations": [],
      "restricted_operations": ["all_response_generation"],
      "required_monitoring": "approval_process_tracking",
      "exit_conditions": {
        "to_L0": "recovery_procedure_completed_and_approval_granted"
      }
    }
  },

  "thresholds": {
    "note": "All threshold values are operator-configurable. No default values are prescribed by this specification. Operators must define and document threshold values before deployment.",
    "L1_entry_threshold": {
      "description": "Drift indicator level at which system transitions from L0 to L1",
      "value": "operator_defined",
      "unit": "operator_defined"
    },
    "L2_entry_threshold": {
      "description": "Drift indicator level at which system transitions from L1 to L2",
      "value": "operator_defined",
      "unit": "operator_defined"
    },
    "L3_entry_threshold": {
      "description": "Drift indicator level at which system transitions from L2 to L3",
      "value": "operator_defined",
      "unit": "operator_defined"
    },
    "L0_return_threshold": {
      "description": "Sustained drift indicator level required before return to L0 from L1 is permitted",
      "value": "operator_defined",
      "sustained_duration": "operator_defined"
    }
  },

  "transition_rules": {
    "allowed_transitions": [
      {
        "from": "L0", "to": "L1",
        "trigger": "drift_indicators_exceed_L1_threshold",
        "guard": "threshold_confirmed_by_monitoring_layer",
        "human_action": "notification",
        "logging_required": true
      },
      {
        "from": "L1", "to": "L0",
        "trigger": "drift_indicators_resolve_below_L0_threshold",
        "guard": "sustained_resolution_confirmed",
        "human_action": "none",
        "logging_required": true
      },
      {
        "from": "L1", "to": "L2",
        "trigger": "drift_indicators_exceed_L2_threshold",
        "guard": "threshold_confirmed",
        "human_action": "notification",
        "logging_required": true
      },
      {
        "from": "L2", "to": "L1",
        "trigger": "containment_successful_indicators_reduced",
        "guard": "sustained_improvement_confirmed",
        "human_action": "consultation",
        "logging_required": true
      },
      {
        "from": "L2", "to": "L3",
        "trigger": "containment_insufficient_indicators_worsen",
        "guard": "threshold_confirmed",
        "human_action": "mandatory_review",
        "logging_required": true
      },
      {
        "from": "L3", "to": "L4",
        "trigger": "human_review_initiated",
        "guard": "operator_acknowledgment_received",
        "human_action": "mandatory_review",
        "approver_confirmation_required": true,
        "logging_required": true
      },
      {
        "from": "L4", "to": "L0",
        "trigger": "human_approval_granted_and_recovery_initiated",
        "guard": "recovery_procedure_completed_and_L0_criteria_met",
        "human_action": "approval",
        "logging_required": true
      }
    ],
    "prohibited_transitions": [
      {
        "from": "L3", "to": "L0",
        "reason": "Recovery must pass through L4"
      },
      {
        "from": "L2", "to": "L0",
        "reason": "Containment must resolve through L1 first"
      },
      {
        "from": "L4", "to": "L1",
        "reason": "Recovery must return to L0"
      },
      {
        "from": "L4", "to": "L2",
        "reason": "Recovery must return to L0"
      }
    ]
  },

  "human_roles": {
    "operator": {
      "description": "Responsible for day-to-day operational decisions",
      "authority": ["confirm_transitions", "trigger_emergency_stop", "initiate_review", "request_recovery"],
      "not_authorized": ["approve_recovery_unilaterally"]
    },
    "approver": {
      "description": "Holds authority over recovery approval and exceptional intervention",
      "authority": ["confirm_recovery_standby_transition", "approve_recovery", "override_exceptional_conditions"],
      "not_authorized": ["day_to_day_operational_decisions"]
    },
    "monitor": {
      "description": "Responsible for drift detection and signal generation. May be human, system, or combined role.",
      "authority": ["generate_drift_signals", "notify_operator"],
      "not_authorized": ["state_transition_decisions"]
    },
    "auditor": {
      "description": "Responsible for audit log verification and completeness",
      "authority": ["read_audit_log", "verify_audit_records"],
      "not_authorized": ["operational_decisions", "approve_transitions"]
    }
  },

  "severity_matrix": {
    "L0": {
      "severity": "none",
      "response_required": false,
      "escalation_required": false
    },
    "L1": {
      "severity": "low",
      "response_required": true,
      "escalation_required": false,
      "response_type": "monitoring_intensification"
    },
    "L2": {
      "severity": "medium",
      "response_required": true,
      "escalation_required": true,
      "escalation_target": "approver",
      "response_type": "capability_reduction_and_containment"
    },
    "L3": {
      "severity": "high",
      "response_required": true,
      "escalation_required": true,
      "escalation_target": "approver",
      "response_type": "hard_abort_all_output_halted"
    },
    "L4": {
      "severity": "critical",
      "response_required": true,
      "escalation_required": true,
      "escalation_target": "approver",
      "response_type": "recovery_standby_awaiting_approval"
    }
  },

  "governance": {
    "approval_policy": {
      "recovery_approval_required": true,
      "approved_by": "approver_role",
      "automatic_recovery": false,
      "approval_must_be_logged": true,
      "approval_log_required_fields": ["approver_id", "timestamp", "decision", "rationale"]
    },
    "retention_policy": {
      "description": "Minimum retention period and storage requirements are operator-defined.",
      "minimum_fields_retained": "see audit_log.required_fields",
      "retention_period": "operator_defined",
      "defined_by": "operator_or_governance_team",
      "note": "Retention must comply with applicable regulatory requirements."
    },
    "accountability": {
      "operator": "accountable_for_operational_decisions_within_defined_procedures",
      "approver": "accountable_for_recovery_approval_decisions",
      "monitor": "accountable_for_signal_generation_accuracy",
      "auditor": "accountable_for_audit_record_completeness_and_integrity"
    },
    "separation_of_duties": {
      "prohibited_combinations": [
        {
          "combination": "operator_approves_own_recovery",
          "reason": "Removes independent review from recovery process"
        },
        {
          "combination": "approver_performs_day_to_day_operation",
          "reason": "Conflates authority levels"
        },
        {
          "combination": "auditor_participates_in_operational_decisions",
          "reason": "Compromises audit independence"
        },
        {
          "combination": "monitor_holds_transition_authority",
          "reason": "Conflates detection with decision"
        }
      ],
      "permitted_combinations": [
        {
          "combination": "operator_and_monitor",
          "condition": "combined_role_must_not_hold_approval_authority",
          "note": "Permitted in constrained deployments only"
        }
      ]
    }
  },

  "audit_log": {
    "required": true,
    "required_fields": [
      "timestamp",
      "event_type",
      "from_state",
      "to_state",
      "trigger",
      "guard_satisfied",
      "human_role",
      "human_id",
      "notes"
    ],
    "event_types": [
      "state_transition",
      "notification",
      "consultation",
      "mandatory_review",
      "approval",
      "recovery_initiated",
      "recovery_completed"
    ],
    "notes_required_for": ["approval", "recovery_initiated", "recovery_completed"],
    "retention": "see governance.retention_policy",
    "integrity_responsibility": "auditor_role"
  }
}
